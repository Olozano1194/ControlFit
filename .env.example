# ===========================================
# BASE DE DATOS
# ===========================================
# Desarrollo local con MySQL
DATABASE_URL=mysql://root:123456@localhost:3306/gimnasioreact

# Desarrollo local con PostgreSQL
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gimnasioreact

# Producción (Render proporciona esta variable automáticamente)
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ===========================================
# SEGURIDAD
# ===========================================
SECRET_KEY=tu-secret-key-aqui


# ===========================================
# USUARIO ADMIN DE DEMOSTRACIÓN (PORTFOLIO)
# ===========================================
# Este usuario se crea automáticamente al iniciar el servidor
# cuando DEBUG=False (en producción de Render).
# 
# NOTA: Eliminar estas variables y el código en apps.py 
# antes de pasar a producción real en un gimnasio.

# Email del admin de demostración
DEMO_ADMIN_EMAIL=reclutador@gimnasio.com

# Contraseña del admin de demostración
DEMO_ADMIN_PASSWORD=Gimnasio2026!

# Nombre del admin
DEMO_ADMIN_NAME=Recruiter

# Apellido del admin
DEMO_ADMIN_LASTNAME=Demo


# ===========================================
# WHATSAPP DEL GIMNASIO
# ===========================================
# Número de WhatsApp para notificaciones (sin +, sin guiones)
# Formato: código país + número (ej: 573001234567 para Colombia)
# Este es el número que recibirá los mensajes de los clientes interesados
WHATSAPP_NUMBER=570000000000

# Credenciales para mensajes al email en producción
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend # para producción y para local usar django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.resend.com # solo para producción, en local no usar
EMAIL_PORT=587   # solo para producción, en local no usar
EMAIL_USE_TLS=True  # solo para producción, en local no usar
EMAIL_HOST_USER=resend # solo para producción, en local no usar
EMAIL_HOST_PASSWORD='tu api_key que te da Resend' # solo para producción, en local no usar
DEFAULT_FROM_EMAIL='nombre de tu app <tu email de Resend>'
